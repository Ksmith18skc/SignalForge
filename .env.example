# ============================================================================
# SignalForge configuration
# Copy this file to `.env` and fill in any keys you have. Everything is
# optional — missing credentials cause the provider to fall back to MockProvider
# so it runs out of the box.
#
# Every variable is prefixed with `SIGNALFORGE_` so it never collides with
# unrelated env vars in your shell (e.g. another project's DATABASE_URL).
# ============================================================================

# ---- runtime ---------------------------------------------------------------
SIGNALFORGE_ENVIRONMENT=dev
SIGNALFORGE_LOG_LEVEL=INFO
SIGNALFORGE_CORS_ALLOW_ORIGINS=http://localhost:8501
SIGNALFORGE_API_URL=http://127.0.0.1:8000
SIGNALFORGE_AUTO_SEED_WATCHLIST=true

# ---- storage ---------------------------------------------------------------
SIGNALFORGE_DATABASE_URL=sqlite:///./signalforge.db

# ---- trading posture (alert-only) ------------------------------------------
SIGNALFORGE_DEFAULT_COPY_MODE=alert_only       # disabled | alert_only | paper | live
SIGNALFORGE_ENABLE_AUTO_TRADING=false           # MUST stay false — no order routing exists

# ---- scanner ---------------------------------------------------------------
SIGNALFORGE_SCAN_INTERVAL_SECONDS=60
SIGNALFORGE_SIGNAL_SCORE_THRESHOLD=50
# Wallet enrichment + market refresh run concurrently. Raise concurrency to
# finish faster (more open sockets); lower it if the provider rate-limits.
# Per-call timeout caps how long any single hung provider call can block.
SIGNALFORGE_SCAN_WALLET_CONCURRENCY=8
SIGNALFORGE_SCAN_PROVIDER_CALL_TIMEOUT_SECONDS=8
# How far back the signal engine looks for trades to turn into signals.
SIGNALFORGE_SIGNAL_RECENT_TRADE_WINDOW_HOURS=48

# ---- Falcon API (primary intelligence provider) ----------------------------
SIGNALFORGE_FALCON_API_KEY=
SIGNALFORGE_FALCON_BASE_URL=https://narrative.agent.heisenberg.so

# ---- Polymarket Analytics (trader watchlist enrichment) --------------------
SIGNALFORGE_POLYMARKET_API_KEY=
SIGNALFORGE_POLYMARKET_BASE_URL=https://gamma-api.polymarket.com

# ---- Kalshi -----------------------------------------------------------------
SIGNALFORGE_KALSHI_API_KEY=
SIGNALFORGE_KALSHI_BASE_URL=https://trading-api.kalshi.com/trade-api/v2

# ---- Alert channels (console always works; the rest are optional) ----------
SIGNALFORGE_DISCORD_WEBHOOK_URL=
SIGNALFORGE_TELEGRAM_BOT_TOKEN=
SIGNALFORGE_TELEGRAM_CHAT_ID=
SIGNALFORGE_ALERT_EMAIL_TO=
SIGNALFORGE_ALERT_EMAIL_FROM=
SIGNALFORGE_SMTP_HOST=
SIGNALFORGE_SMTP_PORT=587
SIGNALFORGE_SMTP_USERNAME=
SIGNALFORGE_SMTP_PASSWORD=
SIGNALFORGE_SMTP_USE_TLS=true
SIGNALFORGE_MIN_DISCORD_SCORE=70
SIGNALFORGE_MIN_TRADE_SIZE_USD=100
SIGNALFORGE_DUPLICATE_WINDOW_MINUTES=30
SIGNALFORGE_HIGH_CONVICTION_SCORE=80
SIGNALFORGE_POSSIBLE_ENTRY_SCORE=85

# ---- Scoring weights -------------------------------------------------------
SIGNALFORGE_SCORING__WALLET_QUALITY=0.35
SIGNALFORGE_SCORING__MULTI_WALLET_CONSENSUS=0.25
SIGNALFORGE_SCORING__LIQUIDITY=0.15
SIGNALFORGE_SCORING__ENTRY_TIMING=0.15
SIGNALFORGE_SCORING__PRICE_INEFFICIENCY=0.10
